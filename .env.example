# macking AI proxy — copy to .env and fill in the keys you have.
# The browser never sees these; only the local proxy (server/index.ts) uses them.
# You can also leave these blank and paste a key in the app's model menu (BYOK).

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Google (Gemini) — either name works
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional: proxy port (default 8787)
# PORT=8787

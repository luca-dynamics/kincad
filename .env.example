# KINCAD AI proxy — copy to .env and fill in the keys you have.
# The browser never sees these; only the local proxy (server/index.ts) uses them.
# You can also leave these blank and paste a key in the app's model menu (BYOK).

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Google (Gemini) — either name works
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# AgentRouter — a third-party gateway that resells several vendors' models behind one
# OpenAI-compatible endpoint. Requests billed to this key run under AgentRouter's terms, not the
# original vendor's. Its models appear in the menu suffixed "· AgentRouter".
AGENTROUTER_API_KEY=
# Override only if you point at a different OpenAI-compatible gateway (OpenRouter, LiteLLM, …)
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
#
# AgentRouter also gates on WHICH CLIENT is asking, not just on the key: a request whose
# User-Agent it does not recognise is answered 401 {"type":"unauthorized_client_error"} — the same
# reply it gives a bad key, so the error tells you nothing. If your key is valid and every call
# still 401s, this is why. Set the agent string AgentRouter authorises for your key. Deliberately
# has no default: the value names a client, and KINCAD will not announce itself as software it
# is not.
# AGENTROUTER_USER_AGENT=

# Optional: proxy port (default 8787)
# PORT=8787

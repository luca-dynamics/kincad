# KINCAD AI proxy — copy to .env and fill in the keys you have.
# The browser never sees these; only the local proxy (server/index.ts) uses them.
# You can also leave these blank and paste a key in the app's model menu (BYOK).

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Google (Gemini) — either name works
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# AgentRouter — a third-party gateway that resells several vendors' models behind one
# OpenAI-compatible endpoint. Requests billed to this key run under AgentRouter's terms, not the
# original vendor's. Its models appear in the menu suffixed "· AgentRouter".
AGENTROUTER_API_KEY=
# Override only if you point at a different OpenAI-compatible gateway (OpenRouter, LiteLLM, …)
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
#
# AgentRouter also gates on WHICH CLIENT is asking, and it does so BEFORE it looks at the key: a
# request whose User-Agent it does not recognise is answered 401 {"type":"unauthorized_client_error"},
# and a request carrying no key at all is answered identically, so the error tells you nothing about
# your credential. Set the agent string AgentRouter authorises for your account; their reply names a
# support channel for arranging one. Deliberately has no default: the value names a client, and
# KINCAD will not announce itself as software it is not.
#
# Until this is set, the "· AgentRouter" models stay OUT of the model menu even with a valid key
# above, because a key alone cannot get past the client gate. Not needed when AGENTROUTER_BASE_URL
# points at a gateway that authenticates on the key alone.
# AGENTROUTER_USER_AGENT=

# Optional: proxy port (default 8787)
# PORT=8787
